export class Produto {

  id!: number;
  nome!: string;
  descricao!: string;
  preco!: number;
  estoque!: number;
  ativo!: boolean;
  categoriaId!: number;
  categoriaNome!: string;

  constructor(
    id: number,
    nome: string,
    descricao: string,
    preco: number,
    estoque: number,
    ativo: boolean,
    categoriaId: number,
    categoriaNome: string = ''
  ) {
    this.id = id;
    this.nome = nome;
    this.descricao = descricao;
    this.preco = preco;
    this.estoque = estoque;
    this.ativo = ativo;
    this.categoriaId = categoriaId;
    this.categoriaNome = categoriaNome;
  }
}